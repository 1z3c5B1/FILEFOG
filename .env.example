# ===========================================================
#  Trambot — конфигурация. Скопируй этот файл в .env и заполни.
# ===========================================================

# --- Telegram ---
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Юзернейм бота без @ (для кнопок-ссылок)
BOT_USERNAME=trambot
# ID админов через запятую, у них расширенные настройки
ADMINS=

# --- Web ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Внешний адрес веб-панели (для OAuth callback). Локально: http://127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Кнопка-мини-апп в боте. Telegram принимает только HTTPS,
# поэтому на localhost кнопка не появится — это нормально.
WEBAPP_ENABLED=true
# Адрес мини-аппа. Пусто = PUBLIC_BASE_URL.
# Можно указать отдельный URL целиком, если панель на другом домене.
WEBAPP_PATH=
# Секрет для подписи cookie-сессий и шифрования токенов.
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_Super_Secret_Key_Generate_New_One

# --- Storage ---
# Корневая папка локального хранилища
STORAGE_DIR=./storage
# Максимальный размер одного файла, МБ
MAX_FILE_MB=100
# Суммарная квота на пользователя, МБ (0 = без лимита)
USER_QUOTA_MB=2048

# --- База данных ---
# Пусто = локальный SQLite (данные ПРОПАДАЮТ при пересоздании контейнера).
# Для Render это значит, что пропадут аккаунты, настройки и привязка
# Google Диска. Задайте DATABASE_URL, чтобы всё переживало redeploy.
# Neon даёт 0.5 ГБ бесплатно и без карты: neon.tech -> Create project ->
# скопируйте строку "postgresql://..." из консоли.
# DATABASE_URL=postgresql://user:pass@epic-name-123456/dbname?sslmode=require
DATABASE_URL=

# --- S3-совместимое хранилище: Cloudflare R2 / Backblaze B2 / MinIO ---
# Пока заданы НЕ все четыре переменные ниже, работает обычная папка.
# Заданы все четыре - приложение переключается на S3 само, перезагрузка не нужна.
# Ключи: R2 -> Manage R2 Storage -> Account API Tokens -> Create Account API Token
# Права токена: Object Read & Write. Секретный ключ показывается один раз.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=<имя-бакета>
S3_ACCESS_KEY=
S3_SECRET_KEY=
# R2 всегда "auto". Для MinIO обычно свой регион, для B2 - регион бакета.
S3_REGION=auto
# Необязательно: общий префикс, если один бакет делят несколько установок.
S3_PREFIX=
# Обычно менять не нужно.
S3_SERVICE=s3
S3_TIMEOUT=60

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Добавь в Authorized redirect URIs: {PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- GitHub OAuth (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# --- Discord OAuth (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# --- Yandex OAuth (https://oauth.yandex.ru/client/new) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=
