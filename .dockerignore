# секреты не должны попасть в образ
.env
.env.*
!.env.example

# данные пользователей монтируются volume-ом
# ведущий слэш обязателен: иначе выпадут app/storage/ и app/data/
/data/
/storage/
*.db
*.db-journal
*.db-wal
*.db-shm

# виртуальное окружение и кэш
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# локальные артефакты
out.txt
res.txt
*.log
.idea/
.vscode/
.DS_Store
