# Caddy сам берёт бесплатный Let's Encrypt сертификат.
# Замени neonex.ru на свой домен перед запуском.
neonex.ru {
	encode zstd gzip

	# загрузка файлов: снимаем лимит тела запроса на уровне прокси
	request_body {
		max_size 2GB
	}

	reverse_proxy app:8000 {
		# долгие загрузки и видео
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
