# --- секреты: никогда не коммитить ---
.env
.env.*
!.env.example
*.pem
*.key

# --- окружение и кэш ---
__pycache__/
*.py[cod]
*$py.class
/.venv/
/venv/
/env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- данные пользователей: только на диске, не в git ---
# ведущий слэш обязателен: без него git игнорирует ЛЮБОЙ вложенный
# каталог storage/ или data/, включая пакет app/storage/
/data/
/storage/
*.db
*.db-journal
*.db-wal
*.db-shm

# --- логи и временные файлы ---
*.log
out.txt
res.txt
*.pid

# --- редакторы и ОС ---
.idea/
.vscode/
.DS_Store
Thumbs.db
